# Local PostgreSQL: create the DB first: `createdb zakat_hr_demo` (or via pgAdmin).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zakat_hr_demo?schema=public"

# The address of your deployed ZakatAuditLog contract on Sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# After copying to .env: npm run db:setup  (applies schema + seeds demo employees, enrollments, payroll, audit chain)
